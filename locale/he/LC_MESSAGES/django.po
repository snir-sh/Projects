# Hebrew translations for survey system
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: he\n"

msgid "Surveys assigned to you"
msgstr "סקרים שהוקצו לך"

msgid "Survey"
msgstr "סקר"

msgid "Status"
msgstr "סטטוס"

msgid "Action"
msgstr "פעולה"

msgid "Completed"
msgstr "הושלם"

msgid "Draft in progress"
msgstr "טיוטה בתהליך"

msgid "New"
msgstr "חדש"

msgid "View/Edit"
msgstr "צפייה/עריכה"

msgid "Resume"
msgstr "חזור להמשך"

msgid "Start"
msgstr "התחל"

msgid "No surveys available for your group."
msgstr "אין סקרים זמינים לקבוצה שלך."

msgid "Log out"
msgstr "התנתקות"

msgid "Resuming draft"
msgstr "חזרה לטיוטה"

msgid "Your previous responses have been loaded. Save or submit when ready."
msgstr "התשובות הקודמות שלך נטענו. שמור או הגש כשאתה מוכן."

msgid "Save your responses as a draft and continue later"
msgstr "שמור את התשובות שלך כטיוטה וחזור מאוחר יותר"

msgid "Save Draft"
msgstr "שמור טיוטה"

msgid "Submit"
msgstr "הגש"

msgid "Back"
msgstr "חזור"

msgid "Select up to %(counter)s option."
msgid_plural "Select up to %(counter)s options."
msgstr[0] "בחר עד %(counter)s אפשרות."
msgstr[1] "בחר עד %(counter)s אפשרויות."

msgid "Thank you"
msgstr "תודה"

msgid "Your responses for \"%(title)s\" have been submitted."
msgstr "התשובות שלך עבור \"%(title)s\" הוגשו."

msgid "Back to surveys"
msgstr "חזור לסקרים"

msgid "Survey submitted successfully!"
msgstr "הסקר הוגש בהצלחה!"

msgid "Survey draft saved."
msgstr "טיוטת הסקר נשמרה."
