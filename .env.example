# Environment Variables - Copy this file to .env and fill in your actual values
# Never commit .env file with real keys to version control!

# OpenAI API Key
# Get it at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Discord Bot Token
# Create a bot at: https://discord.com/developers/applications
DISCORD_TOKEN=your-discord-bot-token-here

# Telegram Bot Token
# Create a bot at: https://t.me/BotFather
TELEGRAM_TOKEN=your-telegram-bot-token-here

# Google Maps API Key
# Get it at: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Django Secret Key (for survey project)
# Generate a new one with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=your-django-secret-key-here

# Django Default User Password (development only)
DEFAULT_USER_PASSWORD=your-default-password-here
